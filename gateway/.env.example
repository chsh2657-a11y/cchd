# ==== cchd 통합 게이트웨이 환경변수 예시 ====
# 이 파일은 예시입니다. 실제 값은 같은 폴더에 .env 파일을 만들어 입력하세요.
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 이미 등록되어 있어야 합니다).

# --- MoneyPrinterTurbo (통합 영상 제작 에이전트) ---
MONEYPRINTERTURBO_URL=http://moneyprinterturbo:8080
OPENAI_API_KEY=
GEMINI_API_KEY=
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Audiocraft(MusicGen) 자체 음악 생성 서버 (선택, 무료) ---
# 자체 서버를 운영하지 않으면 비워두고 아래 muapi.ai 설정을 사용하세요.
AUDIOCRAFT_URL=

# --- muapi.ai (이미지/음악 생성, 유료) ---
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai
